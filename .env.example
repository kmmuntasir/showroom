# democtl environment — copy to /etc/democtl/democtl.env (mode 0600).
# Names only here; real values live on the host, never in git.

# LAN-only listen address (never exposed directly; public path is
# Cloudflare -> Zoraxy -> this listener).
DEMOCTL_LISTEN=192.0.2.10:5000

# The control dashboard host (must differ from the base domain).
DEMOCTL_CONTROL_HOST=demos.example.com

# Base domain; demo sites are <name>.<base>.
DEMOCTL_BASE_DOMAIN=example.com

# Data locations (defaults shown).
DEMOCTL_DATA_DIR=/srv/democtl
DEMOCTL_DB_PATH=/var/lib/democtl/democtl.db
DEMOCTL_AUDIT_PATH=/var/lib/democtl/audit.jsonl

# Session signing key — at least 32 bytes (generate: openssl rand -hex 32).
DEMOCTL_SESSION_KEY=

# Google OAuth — create a web application client; add
# https://<DEMOCTL_CONTROL_HOST>/oauth2/callback as an authorized redirect
# URI. Values live only in this env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace domain — enforced server-side at the OAuth callback.
GOOGLE_WORKSPACE_DOMAIN=
